{
	// Worker 基本信息
	"name": "warden-worker",
	"main": "build/index.js",
	"compatibility_date": "2025-09-19",
	// D1 数据库绑定（必须完整，否则会被认为是新建/覆盖）
	"d1_databases": [
		{
			"binding": "vault1",
			"database_name": "warden-sql",
			"database_id": "a8169727-90e1-4fba-a475-b177ca619d85"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	// 构建配置（等价于 [build]）
	"build": {
		"command": "worker-build --release"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "HEAVY_DO", "class_name": "HeavyDo" }
		]
	},
	"migrations": [
		{ "tag": "heavy_do_v1", "new_sqlite_classes": ["HeavyDo"] }
	],
	"assets": {
		"directory": "./static/web-vault",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/identity/*",
			"/sends/*",
			"/demo.html",
			"/admin.html"
		]
	}
}
