{
  "name": "__WORKER_NAME__",
  "main": "build/index.js",
  "compatibility_date": "2025-09-19",
  "d1_databases": [
    {
      "binding": "vault1",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "sql/migrations"
    }
  ],
  "build": { "command": "worker-build --release" },
  "durable_objects": {
    "bindings": [
      { "name": "HEAVY_DO", "class_name": "HeavyDo" }
    ]
  },
  "migrations": [
    { "tag": "heavy_do_v1", "new_sqlite_classes": ["HeavyDo"] }
  ],
  "observability": { "logs": { "enabled": true, "persist": true } },
  "assets": {
    "directory": "./static/web-vault",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/identity/*", "/sends/*", "/demo.html", "/admin.html"]
  }
}
